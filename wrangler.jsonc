{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "air-duct-experts-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "workers_dev": true,
  "routes": [
    { "pattern": "getairductexperts.com/*", "zone_name": "getairductexperts.com" },
    { "pattern": "www.getairductexperts.com/*", "zone_name": "getairductexperts.com" }
  ],
  "send_email": [{ "name": "EMAIL" }],
}
